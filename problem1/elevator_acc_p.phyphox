<phyphox version="1.14" locale="en">
  <title>Elevator a vs P</title>
  <category>PHY410/505</category>
  <icon format="base64"></icon>
  <description>
        Compare barometer and accelerometer for measuring elevator altitude and velocity.

        Ideally, find an elevator with at least 5 floors for the measurement. During the measurement, the phone should lie flat on the floor of the elevator (consider using a paper towel if the floor is dirty). With the elevator at rest, select the desired floors for the experiment, then press "play" to start recording data before the elevator starts moving. When the elevator reaches the final position, press "pause" to stop recording data, then export the data to your favorite format (excel, csv, etc.). Make sure you can remember which file corresponds to which experiment.

        Do the following variations. Considering doing a couple trials to ensure you have good data, but no need to go crazy here.

        1. Up versus down 
        2. One smooth journey from start to finish, versus stopping at every floor
    </description>
  <data-containers>
    <container size="0">P</container>
    <container size="0">t_P</container>
    <container size="0">a_x</container>
    <container size="0">a_y</container>
    <container size="0">a_z</container>
    <container size="0">t_a</container>
  </data-containers>
  <input>
    <sensor type="pressure" rate="0" average="true">
      <output component="x">P</output>
      <output component="t">t_P</output>
    </sensor>
    <sensor type="linear_acceleration" rate="0" average="true">
      <output component="t">t_a</output>
      <output component="x">a_x</output>
      <output component="y">a_y</output>
      <output component="z">a_z</output>
    </sensor>
  </input>
  <views>
    <view label="Raw Data">
      <graph label="Pressure" timeOnX="true" labelX="[[quantity_short_time]]" unitX="[[unit_short_second]]" labelY="[[quantity_short_pressure]]" unitY="[[unit_short_hecto_pascal]]" partialUpdate="true">
        <input axis="x">t_P</input>
        <input axis="y">P</input>
      </graph>
      <graph label="Accelerometer z" timeOnX="true" labelX="[[quantity_short_time]]" unitX="[[unit_short_second]]" labelY="[[quantity_short_acceleration]]" unitY="[[unit_short_meter_per_square_second]]" unitYperX="m/s³" partialUpdate="true">
        <input axis="x">t_a</input>
        <input axis="y">a_z</input>
      </graph>
      <graph label="Accelerometer x" timeOnX="true" labelX="[[quantity_short_time]]" unitX="[[unit_short_second]]" labelY="[[quantity_short_acceleration]]" unitY="[[unit_short_meter_per_square_second]]" unitYperX="m/s³" partialUpdate="true">
        <input axis="x">t_a</input>
        <input axis="y">a_x</input>
      </graph>
      <graph label="Accelerometer y" timeOnX="true" labelX="[[quantity_short_time]]" unitX="[[unit_short_second]]" labelY="[[quantity_short_acceleration]]" unitY="[[unit_short_meter_per_square_second]]" unitYperX="m/s³" partialUpdate="true">
        <input axis="x">t_a</input>
        <input axis="y">a_y</input>
      </graph>
    </view>
  </views>
  <analysis>
  </analysis>
  <export>
    <set name="Pressure">
      <data name="Time (s)">t_P</data>
      <data name="Pressure (hPa)">P</data>
    </set>
    <set name="Acceleration">
      <data name="Time (s)">t_a</data>
      <data name="Acceleration x (m/s²)">a_x</data>
      <data name="Acceleration y (m/s²)">a_y</data>
      <data name="Acceleration z (m/s²)">a_z</data>
    </set>
  </export>
</phyphox>
